<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DCCExpressLite.Installer.MainWindow"
        Title="DCCExpressLite Installer"
        Width="1120" Height="760" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="270,*">
    <Border Grid.Column="0" Background="#0D131E" BorderBrush="#212C3E" BorderThickness="0,0,1,0" Padding="24">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="10">
          <Border Width="52" Height="52" CornerRadius="14" Background="#5B5CF6" HorizontalAlignment="Left">
            <TextBlock Text="DX" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="DCC EXPRESS" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="LITE INSTALLER" FontSize="12" FontWeight="SemiBold" Foreground="#8B8DFF" LetterSpacing="2" />
          <TextBlock Text="Flash and recover your EX-CSB1 without PlatformIO or Python." Classes="muted" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,46,0,0" Spacing="22">
          <Grid ColumnDefinitions="34,*" RowDefinitions="Auto,Auto">
            <Border Width="28" Height="28" CornerRadius="14" Background="#5B5CF6"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
            <TextBlock Grid.Column="1" Text="Connect device" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Border Grid.Row="1" Margin="13,2,0,0" Width="2" Height="24" Background="#29364B" HorizontalAlignment="Left" />
          </Grid>
          <Grid ColumnDefinitions="34,*" RowDefinitions="Auto,Auto">
            <Border Width="28" Height="28" CornerRadius="14" Background="#243149"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
            <TextBlock Grid.Column="1" Text="Choose release" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Border Grid.Row="1" Margin="13,2,0,0" Width="2" Height="24" Background="#29364B" HorizontalAlignment="Left" />
          </Grid>
          <Grid ColumnDefinitions="34,*">
            <Border Width="28" Height="28" CornerRadius="14" Background="#243149"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
            <TextBlock Grid.Column="1" Text="Install firmware" VerticalAlignment="Center" FontWeight="SemiBold" />
          </Grid>
        </StackPanel>

        <Border Grid.Row="2" Background="#111B29" CornerRadius="9" Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="CROSS-PLATFORM" Foreground="#63DFC2" FontSize="11" FontWeight="Bold" />
            <TextBlock x:Name="PlatformText" Text="Windows · macOS · Linux" FontSize="12" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="30,24,30,30" Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Install DCCExpressLite" FontSize="27" FontWeight="Bold" />
            <TextBlock Text="Connect the EX-CSB1 with USB, then select a firmware release." Classes="muted" Margin="0,4,0,0" />
          </StackPanel>
          <Border Grid.Column="1" Background="#10261F" BorderBrush="#1F755B" BorderThickness="1" CornerRadius="20" Padding="12,7" VerticalAlignment="Center">
            <TextBlock x:Name="TopStatusText" Text="READY" Foreground="#63DFC2" FontSize="12" FontWeight="Bold" />
          </Border>
        </Grid>

        <Border Classes="card">
          <StackPanel Spacing="13">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="1  EX-CSB1 connection" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="The USB serial port is used for the first install and recovery." Classes="caption" Margin="0,3,0,0" />
              </StackPanel>
              <Button Grid.Column="1" x:Name="RefreshPortsButton" Classes="secondary" Content="↻  Rescan" Click="RefreshPorts_Click" />
            </Grid>
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
              <StackPanel Spacing="5">
                <TextBlock Text="Serial port" Classes="caption" />
                <ComboBox x:Name="PortComboBox" MinHeight="39" SelectionChanged="PortComboBox_SelectionChanged" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="Device address" Classes="caption" />
                <TextBox x:Name="DeviceAddressTextBox" Text="http://192.168.1.143" PlaceholderText="http://192.168.1.143" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="13">
            <TextBlock Text="2  Firmware release" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox x:Name="ManifestSourceTextBox" PlaceholderText="GitHub manifest URL or local manifest.json" />
              <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="BrowseManifest_Click" />
              <Button Grid.Column="2" x:Name="LoadReleaseButton" Classes="secondary" Content="Load release" Click="LoadRelease_Click" />
            </Grid>
            <Border x:Name="ReleaseSummaryBorder" IsVisible="False" Background="#0C121C" CornerRadius="8" Padding="13">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock x:Name="ReleaseTitleText" Text="DCCExpressLite" FontWeight="SemiBold" />
                  <TextBlock x:Name="ReleaseNotesText" Classes="caption" TextWrapping="Wrap" MaxWidth="700" />
                </StackPanel>
                <Border Grid.Column="1" Background="#20215A" CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
                  <TextBlock x:Name="ReleaseVersionText" Foreground="#A8A9FF" FontSize="12" FontWeight="Bold" />
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="13">
            <TextBlock Text="3  Install options" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
              <Border Background="#0C121C" CornerRadius="8" Padding="12">
                <CheckBox x:Name="FirmwareCheckBox" IsChecked="True" Content="Firmware + system" />
              </Border>
              <Border Grid.Column="1" Background="#0C121C" CornerRadius="8" Padding="12">
                <CheckBox x:Name="WebUiCheckBox" IsChecked="True" Content="Web UI / LittleFS" />
              </Border>
              <Border Grid.Row="1" Background="#0C121C" CornerRadius="8" Padding="12">
                <CheckBox x:Name="BackupCheckBox" IsChecked="True" Content="Preserve layout + locos" IsCheckedChanged="Backup_IsCheckedChanged" />
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Background="#0C121C" CornerRadius="8" Padding="12">
                <CheckBox x:Name="DefaultDataCheckBox" IsChecked="False" IsEnabled="False" Content="Install sample layout + locos + images" IsCheckedChanged="DefaultData_IsCheckedChanged" />
              </Border>
            </Grid>
            <TextBlock Text="Choose either data preservation or the optional sample package. Sample data replaces the layout and locomotive list after flashing." Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="11">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock x:Name="OperationTitleText" Text="Ready to install" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="OperationDetailText" Text="Select a port and load a firmware release." Classes="caption" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CancelButton" Classes="secondary" Content="Cancel" IsVisible="False" Click="Cancel_Click" />
                <Button x:Name="InstallButton" Classes="primary" Content="Install to EX-CSB1" IsEnabled="False" Click="Install_Click" />
              </StackPanel>
            </Grid>
            <ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" />
            <Expander Header="Installation log">
              <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" MinHeight="130" MaxHeight="210" />
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
