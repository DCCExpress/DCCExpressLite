<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DCCExpressLite.Installer.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#090D14" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#111824" />
      <Setter Property="BorderBrush" Value="#253044" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8D9AAF" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="#8D9AAF" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#5B5CF6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="22,11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#1A2433" />
      <Setter Property="Foreground" Value="#DCE6F7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="Background" Value="#0C121C" />
      <Setter Property="BorderBrush" Value="#2B3850" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
  </Application.Styles>
</Application>
